  "private": true,
  "description": "Festive Events backend — media upload/list APIs with Postgres BYTEA storage",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/dev-server.ts",
    "build": "tsc",
    "start": "node dist/dev-server.js",
